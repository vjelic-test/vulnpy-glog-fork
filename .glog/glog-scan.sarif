                  "endLine": 21,
                  "endColumn": 6,
                  "snippet": {
                    "text": "    return template.render(\n        path=\"/template-xss/jinja\", user_input=request.args.get(\"user_input\", \"\")\n    )"
                  },
                  "sourceLanguage": "python"
                }
              }
            }
