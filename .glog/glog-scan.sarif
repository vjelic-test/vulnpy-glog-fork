                  "endColumn": 6,
                  "snippet": {
                    "text": "    process = subprocess.Popen(\n        command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=True\n    )"
                  },
                  "sourceLanguage": "python"
                }
              }
            }
          ],
          "partialFingerprints": {
